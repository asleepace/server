{
  "name": "wc-language-support",
  "displayName": "WC Single-File Components",
  "description": "Syntax highlighting for .wc single-file web components (@component/@style/@template/@script).",
  "version": "0.0.2",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://example.com/local/wc-language-support.git"
  },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "wc",
        "aliases": ["WC", "wc"],
        "extensions": [".wc"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/wc-language.svg",
          "dark": "./images/wc-language.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "wc",
        "scopeName": "source.wc",
        "path": "./syntaxes/wc.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.css": "css",
          "meta.embedded.block.html": "html",
          "meta.embedded.block.js": "javascript"
        }
      }
    ]
  }
  ,
  "scripts": {
    "package": "npx --yes @vscode/vsce package --no-yarn"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  }
}


